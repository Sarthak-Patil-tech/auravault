{
  "name": "auravault",
  "productName": "AuraVault",
  "version": "1.0.1",
  "description": "A beautifully secure password manager for Windows \u2014 iOS-inspired glass design, zero-knowledge AES-256 encryption, buttery-smooth animations.",
  "main": "main.js",
  "author": "AuraVault Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/auravault"
  },
  "keywords": [
    "password-manager",
    "electron",
    "windows",
    "security",
    "vault",
    "aes-256",
    "glassmorphism",
    "ios-design"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "node scripts/build-icons.js",
    "shots": "electron . --shoot",
    "shots:web": "node scripts/web-shots.js",
    "prepack": "node scripts/build-icons.js",
    "predist": "node scripts/build-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:all": "electron-builder --win nsis portable",
    "wallpapers": "node scripts/make-wallpapers.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.4",
    "to-ico": "^1.1.5"
  }
}